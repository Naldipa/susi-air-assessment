{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__vercel_path=:path*"
    }
  ],
  "functions": {
    "api/handler.js": {
      "includeFiles": "data/*.json"
    }
  }
}
